#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CORE="$SCRIPT_DIR/layout_core.py"

TMP_IN="$(mktemp)"
TMP_OUT="$(mktemp)"
trap 'rm -f "$TMP_IN" "$TMP_OUT"' EXIT

wl-paste -t text/plain > "$TMP_IN" 2>/dev/null || exit 0

set +e
python3 "$CORE" majority "$TMP_IN" > "$TMP_OUT"
status=$?
set -e

if [[ "$status" == "10" ]]; then
    exit 0
elif [[ "$status" != "0" ]]; then
    exit "$status"
fi

if [[ ! -s "$TMP_OUT" ]]; then
    exit 0
fi

wl-copy < "$TMP_OUT" || {
    notify-send "Ошибка конвертации" "Не удалось записать результат в буфер" 2>/dev/null || true
    exit 1
}

notify-send "Раскладка текста" "Буфер приведён к языку большинства" 2>/dev/null || true
